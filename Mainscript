local function updateSelfVisuals(cam)
    local char = LocalPlayer.Character
    if not char then
        FeetRingFrame.Visible = false
        return
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then
        FeetRingFrame.Visible = false
        return
    end

    if State.WhiteSelfEnabled then
        local matName = SelfMaterialOptions[State.WhiteSelfMaterialIndex] or "Neon"
        local targetMat = Enum.Material[matName] or Enum.Material.Neon
        for _, desc in ipairs(char:GetDescendants()) do
            if desc:IsA("BasePart") and BodyPartNames[desc.Name] and desc.Name ~= "HumanoidRootPart" then
                if not SavedPartProps[desc] then
                    SavedPartProps[desc] = {
                        Color = desc.Color,
                        Material = desc.Material,
                        Reflectance = desc.Reflectance,
                    }
                end
                desc.Color = State.SelfWhiteColor
                desc.Material = targetMat
            elseif State.HideSelfClothes then
                if desc:IsA("Shirt") then
                    if not SavedClothes[desc] and desc.ShirtTemplate ~= "" then
                        SavedClothes[desc] = desc.ShirtTemplate
                    end
                    desc.ShirtTemplate = ""
                elseif desc:IsA("Pants") then
                    if not SavedClothes[desc] and desc.PantsTemplate ~= "" then
                        SavedClothes[desc] = desc.PantsTemplate
                    end
                    desc.PantsTemplate = ""
                elseif desc:IsA("ShirtGraphic") then
                    if not SavedClothes[desc] and desc.Graphic ~= "" then
                        SavedClothes[desc] = desc.Graphic
                    end
                    desc.Graphic = ""
                end
            end
        end
    elseif next(SavedPartProps) ~= nil then
        restoreSelfAppearance()
    end

    if State.SelfHighlightEnabled then
        if not SelfHighlight or not SelfHighlight.Parent then
            local hl = Instance.new("Highlight")
            hl.Name = "1337_SelfHighlight"
            hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            hl.Parent = ScreenLayer
            SelfHighlight = hl
        end
        if SelfHighlight then
            SelfHighlight.Adornee = char
            SelfHighlight.FillColor = State.SelfWhiteColor
            SelfHighlight.FillTransparency = State.SelfFillTransparency
            SelfHighlight.OutlineColor = State.SelfShadowOutline and State.SelfShadowColor or State.AccentColor
            SelfHighlight.OutlineTransparency = State.SelfOutlineTransparency
            SelfHighlight.Enabled = true
        end
    elseif SelfHighlight then
        SelfHighlight.Enabled = false
    end

    if State.SelfFeetRingOverlay then
        local feetWorld = (RealCombatCFrame and RealCombatCFrame.Position or hrp.Position) - Vector3.new(0, 2.9, 0)
        local screenPos, onScreen = cam:WorldToViewportPoint(feetWorld)
        if onScreen and screenPos.Z > 0 then
            local scaleFactor = math.clamp(1200 / math.max(screenPos.Z, 5), 24, 130)
            FeetRingFrame.Position = UDim2.new(0, math.floor(screenPos.X), 0, math.floor(screenPos.Y))
            FeetRingFrame.Size = UDim2.new(0, math.floor(scaleFactor * 1.4), 0, math.floor(scaleFactor * 0.55))
            FeetRingFrame.Visible = true
        else
            FeetRingFrame.Visible = false
        end
    else
        FeetRingFrame.Visible = false
    end
end

local function resetTPoseTransforms()
    local char = LocalPlayer.Character
    if not char then
        return
    end
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("Motor6D") and desc.Name ~= "Root" and desc.Name ~= "RootJoint" then
            pcall(function()
                desc.Transform = CFrame.identity
            end)
        end
    end
end

local function stepTPose(char)
    for _, desc in ipairs(char:GetDescendants()) do
        if desc:IsA("Motor6D") then
            local n = desc.Name
            if n == "Right Shoulder" or n == "RightShoulder" then
                desc.Transform = CFrame.Angles(0, 0, math.rad(90))
            elseif n == "Left Shoulder" or n == "LeftShoulder" then
                desc.Transform = CFrame.Angles(0, 0, math.rad(-90))
            elseif n == "RightElbow" or n == "LeftElbow" or n == "RightWrist" or n == "LeftWrist" then
                desc.Transform = CFrame.identity
            elseif n == "Right Hip" or n == "Left Hip" or n == "RightHip" or n == "LeftHip" then
                desc.Transform = CFrame.identity
            end
        end
    end
end

