local function classifyWeaponName(name)
    local low = string.lower(name)
    if string.find(low, "carbine")
        or string.find(low, "ar")
        or string.find(low, "m4")
        or string.find(low, "rifle")
        or string.find(low, "ak")
        or string.find(low, "hk")
        or string.find(low, "smg")
        or string.find(low, "mp5")
        or string.find(low, "karabin")
    then
        return "Carbine"
    end
    if string.find(low, "glock")
        or string.find(low, "pistol")
        or string.find(low, "deagle")
        or string.find(low, "revolver")
        or string.find(low, "usp")
        or string.find(low, "handgun")
    then
        return "Glock"
    end
    return "GenericGun"
end

local function restoreWeaponSkins()
    for part, snap in pairs(SavedWeaponParts) do
        pcall(function()
            if part and part.Parent then
                part.Color = snap.Color
                part.Material = snap.Material
                part.Reflectance = snap.Reflectance
            end
        end)
    end
    table.clear(SavedWeaponParts)

    for inst, tex in pairs(SavedWeaponMeshes) do
        pcall(function()
            if inst and inst.Parent then
                if inst:IsA("SpecialMesh") then
                    inst.TextureId = tex
                elseif inst:IsA("MeshPart") then
                    inst.TextureID = tex
                end
            end
        end)
    end
    table.clear(SavedWeaponMeshes)

    for sa, parentPart in pairs(SavedSurfaceAppearances) do
        pcall(function()
            if sa and parentPart and parentPart.Parent then
                sa.Parent = parentPart
            end
        end)
    end
    table.clear(SavedSurfaceAppearances)
end

local function paintWeaponPart(part, targetColor, targetMat)
    if not SavedWeaponParts[part] then
        SavedWeaponParts[part] = {
            Color = part.Color,
            Material = part.Material,
            Reflectance = part.Reflectance,
        }
    end
    part.Color = targetColor
    part.Material = targetMat

    if State.WeaponStripTextures then
        if part:IsA("MeshPart") then
            if not SavedWeaponMeshes[part] and part.TextureID ~= "" then
                SavedWeaponMeshes[part] = part.TextureID
            end
            part.TextureID = ""
        end
        for _, child in ipairs(part:GetChildren()) do
            if child:IsA("SpecialMesh") then
                if not SavedWeaponMeshes[child] and child.TextureId ~= "" then
                    SavedWeaponMeshes[child] = child.TextureId
                end
                child.TextureId = ""
            elseif child:IsA("SurfaceAppearance") then
                SavedSurfaceAppearances[child] = part
                child.Parent = nil
            end
        end
    end
end

local function updateWeaponSkin()
    if not State.WeaponSkinEnabled and not State.GlockSkinEnabled and not State.CarbineSkinEnabled and not State.RainbowGlock and not State.RainbowCarbine then
        if next(SavedWeaponParts) ~= nil then
            restoreWeaponSkins()
        end
        return
    end

    local matName = WeaponMaterialOptions[State.WeaponMaterialIndex] or "Neon"
    local targetMat = Enum.Material[matName] or Enum.Material.Neon
    local hueBase = (os.clock() * (State.RainbowSpeed / 20)) % 1
    local rainbowColA = Color3.fromHSV(hueBase, 0.88, 1)
    local rainbowColB = Color3.fromHSV((hueBase + 0.35) % 1, 0.88, 1)

    local glockCol = State.RainbowGlock and rainbowColA or (WeaponColorOptions[State.GlockColorIndex] or WeaponColorOptions[1]).Color
    local carbineCol = State.RainbowCarbine and rainbowColB or (WeaponColorOptions[State.CarbineColorIndex] or WeaponColorOptions[2]).Color

    local function styleWeaponContainer(container, forcedType)
        local wType = forcedType or classifyWeaponName(container.Name)
        local shouldPaint = false
        local chosenColor = glockCol

        if wType == "Carbine" then
            shouldPaint = State.CarbineSkinEnabled or State.RainbowCarbine or State.WeaponSkinEnabled
            chosenColor = carbineCol
        elseif wType == "Glock" then
            shouldPaint = State.GlockSkinEnabled or State.RainbowGlock or State.WeaponSkinEnabled
            chosenColor = glockCol
        else
            if State.CarbineSkinEnabled or State.RainbowCarbine then
                shouldPaint = true
                chosenColor = carbineCol
            elseif State.GlockSkinEnabled or State.RainbowGlock or State.WeaponSkinEnabled then
                shouldPaint = true
                chosenColor = glockCol
            end
        end

        if not shouldPaint then
            return
        end

        if container:IsA("BasePart") and not BodyPartNames[container.Name] then
            paintWeaponPart(container, chosenColor, targetMat)
        end

        for _, desc in ipairs(container:GetDescendants()) do
            if desc:IsA("BasePart") and not BodyPartNames[desc.Name] then
                if not desc:FindFirstAncestorOfClass("Accessory") then
                    paintWeaponPart(desc, chosenColor, targetMat)
                end
            end
        end
    end

    local char = LocalPlayer.Character
    if char then
        for _, child in ipairs(char:GetChildren()) do
            if child:IsA("Tool") or child:IsA("Model") or child:IsA("Folder") then
                styleWeaponContainer(child, nil)
            elseif child:IsA("BasePart") and not BodyPartNames[child.Name] then
                styleWeaponContainer(child, nil)
            end
        end
    end

    local cam = Workspace.CurrentCamera
    if cam then
        for _, child in ipairs(cam:GetChildren()) do
            if child:IsA("Model") or child:IsA("Tool") or child:IsA("Folder") then
                styleWeaponContainer(child, nil)
            end
        end
    end
end

