local function triggerKillFeedback(victimName, forcePreview)
    if State.KillSoundEnabled or forcePreview then
        local preset = KillSoundPresets[State.KillSoundIndex] or KillSoundPresets[1]
        KillSoundInstance.SoundId = preset.Id
        KillSoundInstance.PlaybackSpeed = preset.Pitch
        KillSoundInstance.Volume = math.clamp(State.KillSoundVolume / 25, 0.1, 4)
        pcall(function()
            KillSoundInstance:Stop()
            KillSoundInstance:Play()
        end)
    end

    if State.HitmarkerEnabled or forcePreview then
        HitmarkerFrame.Visible = true
        KillBanner.Text = "1337 // ELIMINATED: " .. string.upper(victimName)
        KillBanner.TextTransparency = 0
        KillBanner.Position = UDim2.new(0.5, 0, 0.74, 0)
        playTween(KillBanner, TweenMedium, { Position = UDim2.new(0.5, 0, 0.70, 0) })

        task.delay(0.32, function()
            HitmarkerFrame.Visible = false
        end)
        task.delay(1.3, function()
            playTween(KillBanner, TweenMedium, { TextTransparency = 1 })
        end)
    end
end

