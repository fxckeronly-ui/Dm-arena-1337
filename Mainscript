local function isTargetVisible(targetPart, character)
    local cam = Workspace.CurrentCamera
    if not cam then
        return false
    end
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignoreList = { cam }
    if LocalPlayer.Character then
        table.insert(ignoreList, LocalPlayer.Character)
    end
    params.FilterDescendantsInstances = ignoreList
    params.IgnoreWater = true

    local result = Workspace:Raycast(cam.CFrame.Position, targetPart.Position - cam.CFrame.Position, params)
    if not result then
        return true
    end
    return result.Instance:IsDescendantOf(character)
end

local function resolveAimPart(character)
    local desiredName = State.AimPartList[State.AimPartIndex] or "Head"
    local part = character:FindFirstChild(desiredName)
    if part and part:IsA("BasePart") then
        return part
    end
    local head = character:FindFirstChild("Head")
    if head and head:IsA("BasePart") then
        return head
    end
    local hrp = character:FindFirstChild("HumanoidRootPart")
    if hrp and hrp:IsA("BasePart") then
        return hrp
    end
    return nil
end

