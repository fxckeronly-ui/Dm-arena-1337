local function layoutCorners(corners, x, y, w, h, col)
    local len = math.clamp(math.floor(math.min(w, h) * 0.25), 4, 14)
    local thick = 2
    local coords = {
        { x, y, len, thick },
        { x, y, thick, len },
        { x + w - len, y, len, thick },
        { x + w - thick, y, thick, len },
        { x, y + h - thick, len, thick },
        { x, y + h - len, thick, len },
        { x + w - len, y + h - thick, len, thick },
        { x + w - thick, y + h - len, thick, len },
    }
    for i = 1, 8 do
        local c = corners[i]
        local d = coords[i]
        c.Position = UDim2.new(0, d[1], 0, d[2])
        c.Size = UDim2.new(0, d[3], 0, d[4])
        c.BackgroundColor3 = col
        c.Visible = true
    end
end

