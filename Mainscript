local function mountScreenGui(gui)
    local mounted = false
    if type(gethui) == "function" then
        local ok, hui = pcall(gethui)
        if ok and typeof(hui) == "Instance" then
            local okParent = pcall(function()
                gui.Parent = hui
            end)
            if okParent and gui.Parent == hui then
                mounted = true
            end
        end
    end

    if not mounted then
        local okCore = pcall(function()
            gui.Parent = CoreGui
        end)
        if okCore and gui.Parent == CoreGui then
            mounted = true
        end
    end

    if not mounted then
        local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
        if pGui then
            pcall(function()
                gui.Parent = pGui
            end)
        end
    end
end

