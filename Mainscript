local function findRootMotor(char)
    local lowerTorso = char:FindFirstChild("LowerTorso")
    if lowerTorso then
        local r = lowerTorso:FindFirstChild("Root")
        if r and r:IsA("Motor6D") then
            return r
        end
    end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local rj = hrp:FindFirstChild("RootJoint")
        if rj and rj:IsA("Motor6D") then
            return rj
        end
    end
    return nil
end

local function resetInvisibilityState()
    IsSpoofingInvis = false
    RealCombatCFrame = nil
    local char = LocalPlayer.Character
    if not char then
        return
    end
    local rootMotor = findRootMotor(char)
    if rootMotor then
        pcall(function()
            rootMotor.Transform = CFrame.identity
        end)
    end
end

-- =========================================================================
-- INSTANT RESPAWN ENGINE (SKIP 7s COOLDOWN)
-- =========================================================================

local LastRespawnAttempt = 0

local function executeInstantRespawn()
    local now = os.clock()
    if now - LastRespawnAttempt < 0.25 then
        return
    end
    LastRespawnAttempt = now

    for _, obj in ipairs(ReplicatedStorage:GetDescendants()) do
        if obj:IsA("RemoteEvent") then
            local low = string.lower(obj.Name)
            if string.find(low, "spawn") or string.find(low, "deploy") or string.find(low, "respawn") or string.find(low, "play") then
                pcall(function()
                    obj:FireServer()
                    obj:FireServer("Random")
                    obj:FireServer(1)
                end)
            end
        elseif obj:IsA("RemoteFunction") then
            local low = string.lower(obj.Name)
            if string.find(low, "spawn") or string.find(low, "deploy") or string.find(low, "respawn") then
                task.spawn(function()
                    pcall(function()
                        obj:InvokeServer()
                    end)
                end)
            end
        end
    end

    local pGui = LocalPlayer:FindFirstChildOfClass("PlayerGui")
    if pGui then
        for _, desc in ipairs(pGui:GetDescendants()) do
            if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                local nLow = string.lower(desc.Name)
                if string.find(nLow, "time") or string.find(nLow, "wait") or string.find(nLow, "cooldown") or string.find(nLow, "respawn") then
                    pcall(function()
                        desc.Value = 0
                    end)
                end
            elseif desc:IsA("TextButton") or desc:IsA("ImageButton") then
                local bLow = string.lower(desc.Name)
                local txtLow = desc:IsA("TextButton") and string.lower(desc.Text) or ""
                if string.find(bLow, "spawn") or string.find(bLow, "deploy") or string.find(txtLow, "spawn") or string.find(txtLow, "play") or string.find(txtLow, "возрод") then
                    pcall(function()
                        desc.Visible = true
                        desc.Active = true
                        if type(GlobalEnv.firesignal) == "function" then
                            GlobalEnv.firesignal(desc.MouseButton1Click)
                            GlobalEnv.firesignal(desc.Activated)
                        end
                    end)
                end
            elseif desc:IsA("RemoteEvent") then
                pcall(function()
                    desc:FireServer()
