local function readEnvString(key, defaultVal)
    local val = GlobalEnv[key]
    if type(val) == "string" and #val > 0 then
        return val
    end
    return defaultVal
end

local function resolveBindEnum(name, fallback)
    local okKey, keyItem = pcall(function()
        return Enum.KeyCode[name]
    end)
    if okKey and typeof(keyItem) == "EnumItem" then
        return keyItem
    end
    local okMouse, mouseItem = pcall(function()
        return Enum.UserInputType[name]
    end)
    if okMouse and typeof(mouseItem) == "EnumItem" then
        return mouseItem
    end
    return fallback
end

