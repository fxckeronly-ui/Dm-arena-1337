local FlyTickCounter = 0

table.insert(Connections, RunService.Heartbeat:Connect(function(dt)
    if not State.Running or not State.Injected then
        return
    end

    local cam = Workspace.CurrentCamera
    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if State.InstantRespawnEnabled then
        if not myChar or (myHum and myHum.Health <= 0) then
            executeInstantRespawn()
            return
        end
    end

    if not cam or not myChar or not myHrp or not myHum or myHum.Health <= 0 then
        return
    end

    stepFastReload()

    if State.BhopEnabled and not State.FlyEnabled and not UserInputService:GetFocusedTextBox() then
        if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
            if myHum.FloorMaterial ~= Enum.Material.Air then
                myHum.Jump = true
                myHum:ChangeState(Enum.HumanoidStateType.Jumping)
            end
            local moveDir = myHum.MoveDirection
            if moveDir.Magnitude > 0.05 then
                myHrp.AssemblyLinearVelocity = Vector3.new(
                    moveDir.Unit.X * State.BhopSpeed,
                    myHrp.AssemblyLinearVelocity.Y,
                    moveDir.Unit.Z * State.BhopSpeed
                )
            end
        end
    end

    if State.TargetStrafeEnabled and LockedTarget and LockedTarget.Character then
        local tHrp = LockedTarget.Character:FindFirstChild("HumanoidRootPart")
        if tHrp then
            StrafeAngle = (StrafeAngle + dt * (State.TargetStrafeSpeed / math.max(State.TargetStrafeRadius, 1)) * 3) % (math.pi * 2)
            local offset = Vector3.new(
                math.cos(StrafeAngle) * State.TargetStrafeRadius,
                0,
                math.sin(StrafeAngle) * State.TargetStrafeRadius
            )
            local goalPos = tHrp.Position + offset
            local toGoal = goalPos - myHrp.Position
            local maxStep = math.min(myHum.WalkSpeed + 4, State.TargetStrafeSpeed)
            if toGoal.Magnitude > 0.2 then
                myHrp.AssemblyLinearVelocity = Vector3.new(
                    toGoal.Unit.X * maxStep,
                    myHrp.AssemblyLinearVelocity.Y,
                    toGoal.Unit.Z * maxStep
                )
            end
        end
    end

    if State.SpinbotEnabled then
        myHum.AutoRotate = false
        SpinAngle = (SpinAngle + dt * State.SpinSpeed) % 360
        local pos = myHrp.Position
        if State.SpinModeIndex == 1 then
            myHrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(SpinAngle), 0)
        elseif State.SpinModeIndex == 2 then
            local jitter = (math.floor(os.clock() * 20) % 2 == 0) and 115 or -115
            myHrp.CFrame = CFrame.new(pos) * CFrame.Angles(0, math.rad(SpinAngle + jitter), 0)
        else
            myHrp.CFrame = CFrame.new(pos) * CFrame.Angles(math.rad(math.sin(SpinAngle * 0.05) * 25), math.rad(SpinAngle), math.rad(math.cos(SpinAngle * 0.05) * 25))
        end
    end

    if State.FlyEnabled then
        FlyTickCounter = FlyTickCounter + 1
        local moveDir = Vector3.zero
        if not UserInputService:GetFocusedTextBox() then
            local lookFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
            local rightFlat = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
            if lookFlat.Magnitude > 0.001 then
                lookFlat = lookFlat.Unit
            end
            if rightFlat.Magnitude > 0.001 then
                rightFlat = rightFlat.Unit
            end

            if UserInputService:IsKeyDown(Enum.KeyCode.W) then
                moveDir = moveDir + lookFlat
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.S) then
                moveDir = moveDir - lookFlat
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.D) then
                moveDir = moveDir + rightFlat
            end
            if UserInputService:IsKeyDown(Enum.KeyCode.A) then
                moveDir = moveDir - rightFlat
            end
        end

        local vertAxis = 0
        if not UserInputService:GetFocusedTextBox() then
            if UserInputService:IsKeyDown(Enum.KeyCode.Space) then
                vertAxis = 1
            elseif UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) or UserInputService:IsKeyDown(Enum.KeyCode.C) then
                vertAxis = -1
            end
        end

        if moveDir.Magnitude > 0 then
            moveDir = moveDir.Unit
        end

        local baseAllowance = math.max(myHum.WalkSpeed, 16)
        local cappedHorizSpeed = math.min(State.FlySpeed, baseAllowance + 4)
        local cappedVertSpeed = math.min(State.FlyVerticalSpeed, 16)
        local clampedDt = math.clamp(dt, 0.001, 0.035)

        if State.FlyModeIndex == 1 then
            if FlyTickCounter % 18 == 0 then
                myHum:ChangeState(Enum.HumanoidStateType.Climbing)
            elseif FlyTickCounter % 36 == 0 then
                myHum:ChangeState(Enum.HumanoidStateType.Running)
            end
            local dipY = (FlyTickCounter % 24 == 0) and -0.45 or 0.05
            myHrp.AssemblyLinearVelocity = (moveDir * cappedHorizSpeed) + Vector3.new(0, vertAxis * cappedVertSpeed + dipY, 0)
        elseif State.FlyModeIndex == 2 then
            if FlyTickCounter % 20 == 0 then
                myHum:ChangeState(Enum.HumanoidStateType.Landed)
            end
            local stepPos = (moveDir * cappedHorizSpeed * clampedDt) + Vector3.new(0, (vertAxis * cappedVertSpeed) * clampedDt, 0)
            myHrp.CFrame = myHrp.CFrame + stepPos
            myHrp.AssemblyLinearVelocity = Vector3.new(moveDir.X * cappedHorizSpeed * 0.5, 0, moveDir.Z * cappedHorizSpeed * 0.5)
        else
            if FlyTickCounter % 15 == 0 then
                myHum:ChangeState(Enum.HumanoidStateType.Climbing)
            end
            local hoverWave = math.sin(FlyTickCounter * 0.25) * 1.2
            myHrp.AssemblyLinearVelocity = (moveDir * cappedHorizSpeed) + Vector3.new(0, vertAxis * cappedVertSpeed + hoverWave, 0)
        end
    end

    if State.ServerInvisEnabled and State.ServerInvisMode == 1 and not UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1) then
        RealCombatCFrame = myHrp.CFrame
        IsSpoofingInvis = true
        myHrp.CFrame = RealCombatCFrame * CFrame.new(0, -State.ServerInvisDepth, 0)
    else
        IsSpoofingInvis = false
    end
end))

