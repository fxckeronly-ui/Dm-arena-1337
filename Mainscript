    local myChar = LocalPlayer.Character
    local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
    local myHum = myChar and myChar:FindFirstChildOfClass("Humanoid")

    if IsSpoofingInvis and myHrp and RealCombatCFrame then
        myHrp.CFrame = RealCombatCFrame
        IsSpoofingInvis = false
    end

    FpsFrames = FpsFrames + 1
    local now = os.clock()
    if now - FpsClock >= 0.5 then
        CurrentFps = math.clamp(math.floor(FpsFrames / (now - FpsClock) + 0.5), 1, 999)
        FpsFrames = 0
        FpsClock = now
        if Watermark.Visible then
            local bhTag = State.BhopEnabled and "ON" or "OFF"
            WatermarkLabel.Text = string.format("1337 | dm arena | bhop: %s | %d fps", bhTag, CurrentFps)
        end
    end

    local cam = Workspace.CurrentCamera
    if not cam then
        return
    end

    if State.CustomCamFovEnabled then
        cam.FieldOfView = State.CustomCamFov
    end

    if State.SunsetMode then
        Lighting.ClockTime = 17.8
        Lighting.Ambient = Color3.fromRGB(155, 130, 175)
        Lighting.OutdoorAmbient = Color3.fromRGB(190, 140, 165)
    end

    if State.FullbrightMode then
        Lighting.Brightness = 2.5
        Lighting.GlobalShadows = false
    end

    updateWeaponSkin()
    updateSelfVisuals(cam)

    if myHum and State.ShoulderCam then
        myHum.CameraOffset = Vector3.new(State.ShoulderOffsetX, 0.45, 0)
    end

    local viewportCenter = cam.ViewportSize * 0.5
    local mouseLoc = UserInputService:GetMouseLocation()
    local aimOrigin2D = UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter and viewportCenter or mouseLoc

    if State.FovVisible then
        FovCircle.Position = UDim2.new(0, math.floor(aimOrigin2D.X), 0, math.floor(aimOrigin2D.Y))
    end

    if State.CrosshairEnabled then
        CrosshairRoot.Position = UDim2.new(0, math.floor(aimOrigin2D.X), 0, math.floor(aimOrigin2D.Y))
        if State.CrosshairSpin then
            CrosshairAngle = (CrosshairAngle + dt * State.CrosshairSpeed) % 360
            CrosshairRoot.Rotation = CrosshairAngle
        end
        local g = State.CrosshairGap
        local sz = State.CrosshairSize
        local center = 30
        CrosshairArms[1].Position = UDim2.new(0, center, 0, center - g - sz * 0.5)
        CrosshairArms[1].Size = UDim2.new(0, 2, 0, sz)
        CrosshairArms[2].Position = UDim2.new(0, center, 0, center + g + sz * 0.5)
        CrosshairArms[2].Size = UDim2.new(0, 2, 0, sz)
        CrosshairArms[3].Position = UDim2.new(0, center - g - sz * 0.5, 0, center)
        CrosshairArms[3].Size = UDim2.new(0, sz, 0, 2)
        CrosshairArms[4].Position = UDim2.new(0, center + g + sz * 0.5, 0, center)
        CrosshairArms[4].Size = UDim2.new(0, sz, 0, 2)
    end

    local bestCandidate = nil
    local bestDist2D = State.FovRadius

    for plr, entry in pairs(EspCache) do
        local char = plr.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")

        if not char or not hum or not hrp or not head then
            hideEspEntry(entry)
            continue
        end

        local prevHp = HealthSnapshot[plr]
        local currHp = hum.Health
        HealthSnapshot[plr] = currHp

        if prevHp and prevHp > 0 and currHp <= 0 then
            local engagedStamp = EngagedTargets[plr]
            local distMe = myHrp and (myHrp.Position - hrp.Position).Magnitude or 9999
            if (engagedStamp and (now - engagedStamp) <= 8.0) or distMe <= 250 then
                EngagedTargets[plr] = nil
                triggerKillFeedback(plr.DisplayName ~= "" and plr.DisplayName or plr.Name, false)
            end
        end

        if currHp <= 0 then
            hideEspEntry(entry)
            continue
        end

        local sameTeam = isSameTeam(plr)
        applyEnemyHitbox(char, State.AimTeamCheck and sameTeam)

        local worldDist = (cam.CFrame.Position - hrp.Position).Magnitude
        if worldDist > State.MaxDistance then
            hideEspEntry(entry)
            continue
        end

        local aimPart = resolveAimPart(char)
        if State.AimbotEnabled and aimPart and not (State.AimTeamCheck and sameTeam) then
            local screenPt, onScr = cam:WorldToViewportPoint(aimPart.Position)
            if onScr and screenPt.Z > 0 then
                local dist2D = (Vector2.new(screenPt.X, screenPt.Y) - aimOrigin2D).Magnitude
                if dist2D <= bestDist2D then
                    if not State.AimWallCheck or isTargetVisible(aimPart, char) then
                        bestDist2D = dist2D
                        bestCandidate = plr
                    end
                end
            end
        end

        if not State.EspEnabled or (State.EspTeamCheck and sameTeam) then
            hideEspEntry(entry)
            continue
        end

        if State.EspShadowChams then
            if entry.Highlight.Adornee ~= char then
                entry.Highlight.Adornee = char
            end
            entry.Highlight.FillColor = State.AccentColor
            entry.Highlight.OutlineColor = Color3.fromRGB(10, 10, 16)
            entry.Highlight.Enabled = true
        else
            entry.Highlight.Enabled = false
        end

        local rootScreen, onScreen = cam:WorldToViewportPoint(hrp.Position)
        if not onScreen or rootScreen.Z <= 0 then
            entry.Box.Visible = false
            for _, c in ipairs(entry.Corners) do
                c.Visible = false
            end
            entry.NameTag.Visible = false
            entry.DistTag.Visible = false
            entry.HpBg.Visible = false
            continue
        end

        local topVec = cam:WorldToViewportPoint(head.Position + Vector3.new(0, 1.5, 0))
        local botVec = cam:WorldToViewportPoint(hrp.Position - Vector3.new(0, 3.0, 0))

        local boxH = math.clamp(math.abs(botVec.Y - topVec.Y), 8, cam.ViewportSize.Y * 1.5)
        local boxW = math.clamp(boxH * 0.58, 6, cam.ViewportSize.X)
        local boxX = math.floor(rootScreen.X - boxW * 0.5)
        local boxY = math.floor(topVec.Y)

        if State.EspBox then
            entry.Box.Position = UDim2.new(0, boxX, 0, boxY)
            entry.Box.Size = UDim2.new(0, math.floor(boxW), 0, math.floor(boxH))
            entry.BoxStroke.Color = State.AccentColor
            entry.Box.Visible = true
        else
            entry.Box.Visible = false
        end

        if State.EspCorner then
            layoutCorners(entry.Corners, boxX, boxY, math.floor(boxW), math.floor(boxH), State.AccentColor)
        else
            for _, c in ipairs(entry.Corners) do
                c.Visible = false
            end
        end

        if State.EspName then
            local tool = char:FindFirstChildOfClass("Tool")
            local weaponStr = (State.EspWeapon and tool) and (" [" .. tool.Name .. "]") or ""
            entry.NameTag.Text = (plr.DisplayName ~= "" and plr.DisplayName or plr.Name) .. weaponStr
            entry.NameTag.Position = UDim2.new(0, math.floor(rootScreen.X - 90), 0, boxY - 15)
            entry.NameTag.Visible = true
        else
            entry.NameTag.Visible = false
        end

        if State.EspDistance then
            entry.DistTag.Text = string.format("%d HP  •  [%d st]", math.floor(currHp), math.floor(worldDist + 0.5))
            entry.DistTag.Position = UDim2.new(0, math.floor(rootScreen.X - 90), 0, math.floor(boxY + boxH + 2))
            entry.DistTag.Visible = true
        else
            entry.DistTag.Visible = false
        end

        if State.EspHealthBar then
            local ratio = math.clamp(currHp / math.max(hum.MaxHealth, 1), 0, 1)
            local barH = math.floor(boxH)
            local fillH = math.max(1, math.floor(barH * ratio))
            entry.HpBg.Position = UDim2.new(0, boxX - 5, 0, boxY)
            entry.HpBg.Size = UDim2.new(0, 3, 0, barH)
            entry.HpFill.Position = UDim2.new(0, 0, 0, barH - fillH)
            entry.HpFill.Size = UDim2.new(1, 0, 0, fillH)
            entry.HpFill.BackgroundColor3 = Color3.fromHSV(ratio * 0.33, 0.88, 0.95)
            entry.HpBg.Visible = true
        else
            entry.HpBg.Visible = false
        end
    end

    if State.AimbotEnabled and State.AimingActive then
        if State.StickyAim and LockedTarget and LockedTarget.Parent == Players then
            local lChar = LockedTarget.Character
            local lHum = lChar and lChar:FindFirstChildOfClass("Humanoid")
            local lPart = lChar and resolveAimPart(lChar)
            if not lChar or not lHum or lHum.Health <= 0 or not lPart then
                LockedTarget = bestCandidate
            elseif State.AimWallCheck and not isTargetVisible(lPart, lChar) then
                LockedTarget = bestCandidate
            end
        else
            LockedTarget = bestCandidate
        end

        if LockedTarget and LockedTarget.Character then
            EngagedTargets[LockedTarget] = now
            local tChar = LockedTarget.Character
            local tPart = resolveAimPart(tChar)
            local tHum = tChar:FindFirstChildOfClass("Humanoid")
            if tPart and tHum and tHum.Health > 0 then
                local aimPos = tPart.Position
                if State.AimPredict then
                    aimPos = aimPos + tPart.AssemblyLinearVelocity * (State.AimPredictAmount / 200)
                end
                local alpha = math.clamp((101 - State.AimSmoothness) / 100, 0.03, 1)
                cam.CFrame = cam.CFrame:Lerp(CFrame.new(cam.CFrame.Position, aimPos), alpha)
            end
        end
    end

    if State.TriggerEnabled then
        local unitRay = cam:ViewportPointToRay(aimOrigin2D.X, aimOrigin2D.Y)
        local params = RaycastParams.new()
        params.FilterType = Enum.RaycastFilterType.Exclude
        local ignore = { cam }
        if myChar then
            table.insert(ignore, myChar)
        end
        params.FilterDescendantsInstances = ignore
        params.IgnoreWater = true

        local hit = Workspace:Raycast(unitRay.Origin, unitRay.Direction * State.MaxDistance, params)
        if hit and hit.Instance then
            local model = hit.Instance:FindFirstAncestorOfClass("Model")
            local hitPlayer = model and Players:GetPlayerFromCharacter(model)
            if hitPlayer and hitPlayer ~= LocalPlayer then
                local hum = model:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local teamOk = not (State.AimTeamCheck and isSameTeam(hitPlayer))
                    local headOk = not State.TriggerHeadOnly or hit.Instance.Name == "Head"
                    if teamOk and headOk and (now - LastTriggerShot) * 1000 >= State.TriggerDelayMs then
                        LastTriggerShot = now
                        EngagedTargets[hitPlayer] = now
                        if type(GlobalEnv.mouse1click) == "function" then
                            pcall(GlobalEnv.mouse1click)
                        elseif myChar then
                            local tool = myChar:FindFirstChildOfClass("Tool")
                            if tool then
                                pcall(function()
                                    tool:Activate()
                                end)
                            end
                        end
                    end
                end
            end
        end
    end
end))

local function cleanupAll()
    if not State.Running then
        return
    end
    State.Running = false
    setFlyActive(false)
    resetInvisibilityState()
    restoreAllHitboxes()
    restoreWeaponSkins()
    restoreSelfAppearance()

    for _, conn in ipairs(Connections) do
        pcall(function()
            conn:Disconnect()
        end)
    end
    table.clear(Connections)

    for plr, _ in pairs(EspCache) do
        removeEsp(plr)
    end

    pcall(function()
        local char = LocalPlayer.Character
        local hum = char and char:FindFirstChildOfClass("Humanoid")
        if hum then
            hum.CameraOffset = Vector3.zero
            hum.AutoRotate = true
        end
    end)

    pcall(function()
        Lighting.Ambient = OriginalLighting.Ambient
        Lighting.OutdoorAmbient = OriginalLighting.OutdoorAmbient
        Lighting.Brightness = OriginalLighting.Brightness
        Lighting.ClockTime = OriginalLighting.ClockTime
        Lighting.GlobalShadows = OriginalLighting.GlobalShadows
    end)

    pcall(function()
        if Workspace.CurrentCamera then
            Workspace.CurrentCamera.FieldOfView = InitialCameraFov
        end
    end)

    pcall(function()
        ScreenLayer:Destroy()
    end)
    GlobalEnv.__1337_CLEANUP = nil
end

table.insert(Connections, UnloadBtn.MouseButton1Click:Connect(cleanupAll))
GlobalEnv.__1337_CLEANUP = cleanupAll
