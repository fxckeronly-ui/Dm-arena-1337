end

local function formatBindName(item)
    local n = item.Name
    if n == "MouseButton2" then
        return "RMB"
    elseif n == "MouseButton1" then
        return "LMB"
    elseif n == "MouseButton3" then
        return "MMB"
    end
    return n
end

