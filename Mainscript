-- =========================================================================

local function stepFastReload()
    if not State.FastReloadEnabled then
        return
    end
    local char = LocalPlayer.Character
    if not char then
        return
    end
    local hum = char:FindFirstChildOfClass("Humanoid")
    local animator = hum and hum:FindFirstChildOfClass("Animator")
    local reloadKeyHeld = UserInputService:IsKeyDown(Enum.KeyCode.R)

    if animator then
        for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
            local tName = string.lower(track.Name)
            local animId = (track.Animation and string.lower(track.Animation.AnimationId)) or ""
            local isReloadTrack = string.find(tName, "reload")
                or string.find(tName, "mag")
                or string.find(tName, "chamber")
                or string.find(tName, "slide")
                or string.find(animId, "reload")
                or (reloadKeyHeld and track.Priority == Enum.AnimationPriority.Action)

            if isReloadTrack then
                pcall(function()
                    track:AdjustSpeed(State.FastReloadSpeed)
                end)
            end
        end
    end

    for _, child in ipairs(char:GetChildren()) do
        if child:IsA("Tool") or child:IsA("Model") then
            pcall(function()
                for attrName, attrVal in pairs(child:GetAttributes()) do
                    local low = string.lower(attrName)
                    if type(attrVal) == "number" and (string.find(low, "reload") or string.find(low, "cooldown")) then
                        child:SetAttribute(attrName, 0.02)
                    elseif type(attrVal) == "boolean" and string.find(low, "reload") then
                        child:SetAttribute(attrName, false)
                    end
                end
            end)
            for _, desc in ipairs(child:GetDescendants()) do
                if desc:IsA("NumberValue") or desc:IsA("IntValue") then
                    local low = string.lower(desc.Name)
                    if string.find(low, "reload") then
                        pcall(function()
                            desc.Value = 0.02
                        end)
                    end
                elseif desc:IsA("BoolValue") and string.find(string.lower(desc.Name), "reload") then
                    pcall(function()
                        desc.Value = false
                    end)
                end
            end
        end
    end
end

