-- =========================================================================

local ExpandedHitboxes = {}

local function restoreAllHitboxes()
    for part, snap in pairs(ExpandedHitboxes) do
        pcall(function()
            if part and part.Parent then
                part.Size = snap.Size
                part.Transparency = snap.Transparency
                part.CanCollide = snap.CanCollide
                part.Massless = snap.Massless
            end
        end)
    end
    table.clear(ExpandedHitboxes)
end

local function applyEnemyHitbox(char, isTeam)
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")

    if not State.HitboxEnabled or isTeam then
        for _, p in ipairs({ head, hrp }) do
            if p and ExpandedHitboxes[p] then
                local snap = ExpandedHitboxes[p]
                pcall(function()
                    p.Size = snap.Size
                    p.Transparency = snap.Transparency
                    p.CanCollide = snap.CanCollide
                    p.Massless = snap.Massless
                end)
                ExpandedHitboxes[p] = nil
            end
        end
        return
    end

    local targetVec = Vector3.new(State.HitboxSize, State.HitboxSize, State.HitboxSize)
    local transVal = math.clamp(State.HitboxTransparency / 100, 0.1, 0.95)
    local mode = State.HitboxTargetIndex

    local function expandPart(part, active)
        if not part or not part:IsA("BasePart") then
            return
        end
        if active then
            if not ExpandedHitboxes[part] then
                ExpandedHitboxes[part] = {
                    Size = part.Size,
                    Transparency = part.Transparency,
                    CanCollide = part.CanCollide,
                    Massless = part.Massless,
                }
            end
            part.Size = targetVec
            part.Transparency = transVal
            part.CanCollide = false
            part.Massless = true
        elseif ExpandedHitboxes[part] then
            local snap = ExpandedHitboxes[part]
            part.Size = snap.Size
            part.Transparency = snap.Transparency
            part.CanCollide = snap.CanCollide
            part.Massless = snap.Massless
            ExpandedHitboxes[part] = nil
        end
    end

    expandPart(head, mode == 1 or mode == 3)
    expandPart(hrp, mode == 2 or mode == 3)
end

